{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only the app's own ten commands. No core:default (menus, events, path resolution), no shell, filesystem, HTTP or opener plugins.",
  "windows": ["main"],
  "permissions": [
    "allow-prefs-get",
    "allow-prefs-set-language",
    "allow-prefs-set-server",
    "allow-auth-login",
    "allow-auth-logout",
    "allow-api-request",
    "allow-api-download",
    "allow-invoice-download",
    "allow-api-image",
    "allow-client-log"
  ]
}
