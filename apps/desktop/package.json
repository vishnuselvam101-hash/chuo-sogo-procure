{
  "name": "chuo-sogo-procure-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --mode admin",
    "dev:shop": "vite --mode shop",
    "build": "tsc -b && vite build",
    "build:admin": "tsc -b && vite build --mode admin",
    "build:shop": "tsc -b && vite build --mode shop",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../../api/openapi.json -o src/lib/api-schema.ts && prettier --write src/lib/api-schema.ts",
    "gen:api:check": "openapi-typescript ../../api/openapi.json -o .api-schema.check.ts && prettier --write .api-schema.check.ts >/dev/null && cmp -s .api-schema.check.ts src/lib/api-schema.ts; s=$?; rm -f .api-schema.check.ts; [ $s -eq 0 ] || { echo \"src/lib/api-schema.ts is stale: run pnpm gen:api\"; exit 1; }"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "i18next": "26.5.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webdriverio": "10.1.0"
  }
}
