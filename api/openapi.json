  "components": {
    "schemas": {
      "AddMemberRequest": {
        "type": "object",
        "required": [
          "email",
          "display_name",
          "role"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "AddMemberResponse": {
        "type": "object",
        "description": "Identical for new and existing accounts, so it never reveals whether an email is registered.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "AssignmentRequest": {
        "type": "object",
        "required": [
          "user_id"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AuditResponse": {
        "type": "object",
        "required": [
          "events",
          "chain_valid"
        ],
        "properties": {
          "chain_valid": {
            "type": "boolean"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditView"
            }
          },
          "first_broken_seq": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "AuditView": {
        "type": "object",
        "required": [
          "seq",
          "action",
          "entity_type",
          "data",
          "created_at"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor_user_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object"
          },
          "entity_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "entity_type": {
            "type": "string"
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "seq": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CreateOrgRequest": {
        "type": "object",
        "required": [
          "name",
          "admin_email",
          "admin_name"
        ],
        "properties": {
          "admin_email": {
            "type": "string"
          },
          "admin_name": {
            "type": "string"
          },
          "default_locale": {
