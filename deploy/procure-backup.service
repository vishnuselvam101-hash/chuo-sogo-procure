# Nightly backup: database + stored files with checksums, 14 kept (scripts/procure-backup.sh).
# Installed by scripts/install-server.sh.
[Unit]
Description=Chuo-Sogo Procure backup (database and files)

[Service]
Type=oneshot
User=procure
Group=procure
EnvironmentFile=/etc/procure/procure.env
UMask=0077
ExecStart=/opt/procure/bin/procure-backup
